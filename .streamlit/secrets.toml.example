# Copy this file to secrets.toml (local) or paste into Streamlit Community Cloud → Settings → Secrets.
# NEVER commit real tokens.
#
# ALSO add the same keys as GitHub Actions repository secrets for 24/7 alerts
# (see ALERTS_24x7.md and .github/workflows/otp_alert_worker.yml).

LAMIX_URL = "https://panel.lamix.org/api/v1/messages"
LAMIX_TOKEN = "PstOUlBGmW-wBvi1qZgO419BHEmL3oxU8lWR-bKfCBc"

PURPLE_URL = "http://137.74.1.203/crapi/reseller/mdr.php"
PURPLE_TOKEN = "your-purple-token"

REGISTRY_URL = "https://script.google.com/macros/s/YOUR_DEPLOYMENT_ID/exec"
ADMIN_KEY = "your-admin-key"

# Dashboard auth — true = auto-login (no activation code)
AUTH_DISABLED = true

# Optional tuning
SESSION_TIMEOUT_MIN = 1440
API_TIMEOUT = 12
API_RETRIES = 2
LAMIX_RECORDS = 400
PURPLE_RECORDS = 2000
PURPLE_LOOKBACK_DAYS = 30
# TEAM_FILE = "Numbers_Export.csv"

# ---------- WhatsApp OTP Alert Engine ----------
# provider: log | greenapi | callmebot | webhook | meta | twilio
# NOTE: Streamlit only fires alerts while a browser tab is open.
#       24/7 alerts = GitHub Action running alert_worker.py (same secrets).
WHATSAPP_ALERTS_ENABLED = true
WHATSAPP_THRESHOLD = 1
WHATSAPP_WINDOW_MIN = 5
WHATSAPP_COOLDOWN_MIN = 5
WHATSAPP_PROVIDER = "greenapi"

# ★ RECOMMENDED: GREEN-API — YOUR number → YOUR group (free developer tier)
# 1) https://console.green-api.com/  → create instance → scan QR with your WA
# 2) Copy idInstance + apiTokenInstance
# 3) Send any msg in target group from that phone, then copy group chatId (...@g.us)
GREENAPI_ID_INSTANCE = "1101xxxxxxxx"
GREENAPI_API_TOKEN = "xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"
GREENAPI_API_URL = "https://api.green-api.com"
GREENAPI_GROUP_ID = "1203630xxxxxxxxxxxxxxx@g.us"

# Free personal only (CallMeBot) — groups NOT supported
# CALLMEBOT_PHONE = "923001234567"
# CALLMEBOT_APIKEY = "123456"
# WHATSAPP_PROVIDER = "callmebot"

# Make.com / n8n webhook bridge
# WHATSAPP_WEBHOOK_URL = "https://hook.eu2.make.com/xxxxxxxx"
# WHATSAPP_PROVIDER = "webhook"

# Meta WhatsApp Cloud API (later)
# META_WA_TOKEN = ""
# META_WA_PHONE_ID = ""
# META_WA_TO = "923001234567"

# Twilio WhatsApp (later)
# TWILIO_SID = ""
# TWILIO_TOKEN = ""
# TWILIO_WA_FROM = "whatsapp:+14155238886"
# TWILIO_WA_TO = "whatsapp:+923001234567"
